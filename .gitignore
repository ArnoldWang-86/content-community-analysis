# ============================================================
#  原始采集数据：体积大（弹幕 217MB），可由脚本重新采集，
#  不要提交到 GitHub（单文件上限 100MB，会被拒绝）
# ============================================================
data/raw/
data/clean/

# Python 缓存
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# 临时/草稿脚本（下划线开头的都是）
_*.py

# 运行日志
output/

# 测试报告（pytest-html 生成物，可由 pytest --html 重新生成）
tests/report.html

# 编辑器
.vscode/
.idea/

# 敏感配置（API Key）
.env

# 系统文件
Thumbs.db
desktop.ini
~$*
# 本地推送脚本（含本机路径）
推送到GitHub.*
